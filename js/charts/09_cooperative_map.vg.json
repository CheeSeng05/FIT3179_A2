{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Cooperative game share in publisher-linked catalogues",
  "width": "container",
  "height": 680,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/cooperative_countries.csv",
    "format": {
      "type": "csv",
      "parse": {
        "share": "number",
        "eligible_games": "number",
        "cooperative_games": "number"
      }
    }
  },
  "config": {
    "font": "'Source Sans 3'",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#27313a",
      "titleColor": "#27313a",
      "gridColor": "#e9ecef",
      "domain": false,
      "tickColor": "#d8dde0",
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#27313a",
      "titleColor": "#27313a",
      "orient": "bottom",
      "padding": 4,
      "labelLimit": 240
    },
    "text": {
      "fontSize": 14,
      "lineBreak": "~",
      "lineHeight": 17
    }
  },
  "projection": {
    "type": "equalEarth"
  },
  "params": [
    {
      "name": "publication_period",
      "value": "All"
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/world.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.ADMIN !== 'Antarctica'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e6e9ec",
        "stroke": "white",
        "strokeWidth": 0.6
      }
    },
    {
      "transform": [
        {
          "filter": "datum.period == publication_period"
        },
        {
          "filter": "datum.eligible_games >= 50 && isValid(datum.share)"
        },
        {
          "lookup": "country",
          "from": {
            "data": {
              "url": "data/world.topojson",
              "format": {
                "type": "topojson",
                "feature": "ne_110m_admin_0_countries"
              }
            },
            "key": "properties.ADMIN"
          },
          "as": "geo"
        },
        {
          "filter": "isValid(datum.geo)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.6
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "share",
          "type": "quantitative",
          "title": "Cooperative-game percentage",
          "scale": {
            "domain": [
              0,
              0.4
            ],
            "range": [
              "#edf8fb",
              "#b2e2e2",
              "#66c2a4",
              "#2ca25f",
              "#006d2c"
            ],
            "interpolate": "lab"
          },
          "legend": {
            "title": "Cooperative games (%)",
            "orient": "bottom-left",
            "format": ".0%",
            "values": [
              0,
              0.1,
              0.2,
              0.3,
              0.4
            ]
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Publisher country"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Cooperative-game percentage",
            "format": ".1%"
          },
          {
            "field": "cooperative_games",
            "type": "quantitative",
            "title": "Cooperative games",
            "format": ","
          },
          {
            "field": "eligible_games",
            "type": "quantitative",
            "title": "Eligible games",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.period == publication_period && datum.eligible_games >= 50 && isValid(datum.share)"
        },
        {
          "filter": "datum.country == 'Czechia' || datum.country == 'United States of America'"
        },
        {
          "calculate": "datum.country == 'Czechia' ? 15.5 : -98",
          "as": "longitude"
        },
        {
          "calculate": "datum.country == 'Czechia' ? 49.8 : 39",
          "as": "latitude"
        },
        {
          "calculate": "(datum.country == 'Czechia' ? 'Czechia ' : 'USA ') + format(datum.share, datum.country == 'Czechia' ? '.0%' : '.1%')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#27313a",
        "dy": -15
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": []
      },
      "mark": {
        "type": "point",
        "filled": true
      },
      "encoding": {
        "color": {
          "field": "coverage",
          "type": "nominal",
          "scale": {
            "domain": [
              "No data or fewer than 50 eligible games"
            ],
            "range": [
              "#e6e9ec"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom-left",
            "symbolType": "square",
            "symbolSize": 120,
            "symbolOpacity": 1,
            "symbolStroke": "#aab3bc",
            "symbolStrokeWidth": 1,
            "labelExpr": "['No data or fewer than', '50 eligible games']",
            "labelLimit": 220,
            "symbolFill": "#e6e9ec"
          }
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}
