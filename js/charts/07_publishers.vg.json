{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Twelve leading publisher catalogues grouped by verified country",
  "width": 1100,
  "height": 520,
  "padding": 2,
  "autosize": "none",
  "background": "transparent",
  "data": [
    {
      "name": "tree",
      "url": "data/publishers.csv",
      "format": {
        "type": "csv",
        "parse": {
          "games": "number"
        }
      },
      "transform": [
        {
          "type": "formula",
          "expr": "datum.parent == '' ? null : datum.parent",
          "as": "parent"
        },
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "games",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "method": {
            "signal": "width < 500 ? 'binary' : 'squarify'"
          },
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "paddingTop": 24,
          "paddingInner": 2,
          "paddingOuter": 3
        }
      ]
    },
    {
      "name": "countries",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 1"
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "name": "publisher_tiles",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "signal": "datum.country == 'Unverified' ? '#e6e9ec' : '#c4e6df'"
          },
          "stroke": {
            "value": "white"
          },
          "tooltip": {
            "signal": "{'Publisher':datum.publisher,'Country':datum.country,'Credited games':datum.games}"
          }
        },
        "hover": {
          "fill": {
            "value": "#99cfc3"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "country_borders",
      "from": {
        "data": "countries"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": null
          },
          "stroke": {
            "value": "#27313a"
          },
          "strokeWidth": {
            "value": 1.5
          }
        }
      }
    },
    {
      "type": "text",
      "name": "country_labels",
      "from": {
        "data": "countries"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 5"
          },
          "y": {
            "signal": "datum.y0 + 5"
          },
          "text": {
            "field": "publisher"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'Source Sans 3'"
          },
          "fontSize": {
            "value": 14
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#27313a"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "publisher_labels",
      "from": {
        "data": "leaves"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0+datum.x1)/2"
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2 - length(split(datum.publisher, ' '))*9"
          },
          "text": {
            "signal": "split(datum.publisher + ' ' + format(datum.games, ','), ' ')"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "lineHeight": {
            "value": 18
          },
          "font": {
            "value": "'Source Sans 3'"
          },
          "fontSize": {
            "signal": "width < 500 ? 14 : 16"
          },
          "fill": {
            "value": "#27313a"
          }
        }
      }
    }
  ]
}