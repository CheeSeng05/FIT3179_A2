{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Catalogue-wide top ten mechanics within selected years",
  "width": "container",
  "height": 400,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/mechanics_years.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "games": "number",
        "eligible_games": "number",
        "order": "number"
      }
    }
  },
  "config": {
    "font": "'Source Sans 3'",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#27313a",
      "titleColor": "#27313a",
      "gridColor": "#e9ecef",
      "domain": false,
      "tickColor": "#d8dde0",
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#27313a",
      "titleColor": "#27313a",
      "orient": "bottom",
      "padding": 12,
      "labelLimit": 240
    },
    "text": {
      "fontSize": 14,
      "lineBreak": "~",
      "lineHeight": 17
    }
  },
  "params": [
    {
      "name": "start_year",
      "value": 1950
    },
    {
      "name": "end_year",
      "value": 2025
    }
  ],
  "transform": [
    {
      "filter": "datum.year >= start_year && datum.year <= end_year"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "games",
          "as": "games"
        }
      ],
      "groupby": [
        "mechanic"
      ]
    }
  ],
  "mark": {
    "type": "bar",
    "color": "#167d73",
    "cornerRadiusEnd": 2
  },
  "encoding": {
    "x": {
      "field": "games",
      "type": "quantitative",
      "title": "Games",
      "axis": {
        "grid": true
      }
    },
    "y": {
      "field": "mechanic",
      "type": "nominal",
      "title": null,
      "sort": "-x",
      "axis": {
        "labelLimit": 180
      }
    },
    "tooltip": [
      {
        "field": "mechanic",
        "type": "nominal",
        "title": "Mechanic"
      },
      {
        "field": "games",
        "type": "quantitative",
        "title": "Games",
        "format": ","
      }
    ]
  }
}