{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Complexity and recorded playing time",
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/complexity_time.csv",
    "format": {
      "type": "csv",
      "parse": {
        "id": "number",
        "complexity": "number",
        "complexity_votes": "number",
        "minutes": "number",
        "year": "number",
        "max_players": "number"
      }
    }
  },
  "config": {
    "font": "'Source Sans 3'",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#27313a",
      "titleColor": "#27313a",
      "gridColor": "#e9ecef",
      "domain": false,
      "tickColor": "#d8dde0",
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#27313a",
      "titleColor": "#27313a",
      "orient": "bottom",
      "padding": 12,
      "labelLimit": 240
    },
    "text": {
      "fontSize": 14,
      "lineBreak": "~",
      "lineHeight": 17
    }
  },
  "encoding": {
    "x": {
      "field": "minutes_j",
      "type": "quantitative",
      "title": "Recorded playing time (minutes)",
      "scale": {
        "domain": [
          0,
          360
        ]
      },
      "axis": {
        "grid": false,
        "tickCount": 6
      }
    },
    "y": {
      "field": "complexity",
      "type": "quantitative",
      "title": "Complexity (1 light, 5 heavy)",
      "scale": {
        "domain": [
          1,
          5
        ]
      }
    },
    "tooltip": [
      {
        "field": "name",
        "type": "nominal",
        "title": "Game"
      },
      {
        "field": "year",
        "type": "quantitative",
        "title": "Publication year",
        "format": "d"
      },
      {
        "field": "minutes",
        "type": "quantitative",
        "title": "Minutes"
      },
      {
        "field": "complexity",
        "type": "quantitative",
        "title": "Complexity",
        "format": ".2f"
      },
      {
        "field": "complexity_votes",
        "type": "quantitative",
        "title": "Complexity votes",
        "format": ","
      }
    ]
  },
  "layer": [
    {
      "transform": [
        {
          "calculate": "clamp(datum.minutes + (random() - 0.5) * 8, 0, 360)",
          "as": "minutes_j"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#965071",
        "opacity": 0.45,
        "size": 27
      }
    },
    {
      "data": {
        "values": [
          {
            "minutes_j": 15,
            "complexity": 4.6,
            "note": [
              "30 minutes or less:",
              "middle score 1.4"
            ]
          },
          {
            "minutes_j": 250,
            "complexity": 1.6,
            "note": [
              "2 hours or more:",
              "middle score 3.0"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": {
          "expr": "datum.minutes_j > 180 ? 'right' : 'left'"
        },
        "fontWeight": "bold",
        "lineHeight": 17,
        "color": "#27313a"
      },
      "encoding": {
        "text": {
          "field": "note",
          "type": "nominal"
        },
        "tooltip": {
          "value": null
        }
      }
    }
  ]
}