{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Selected games in three historical ranking lists",
  "width": "container",
  "height": 400,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/rank_comparison.csv",
    "format": {
      "type": "csv",
      "parse": {
        "id": "number",
        "rank": "number",
        "order": "number",
        "local_ratings": "number"
      }
    }
  },
  "config": {
    "font": "'Source Sans 3'",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#27313a",
      "titleColor": "#27313a",
      "gridColor": "#e9ecef",
      "domain": false,
      "tickColor": "#d8dde0",
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#27313a",
      "titleColor": "#27313a",
      "orient": "bottom",
      "padding": 12,
      "labelLimit": 240
    },
    "text": {
      "fontSize": 14,
      "lineBreak": "~",
      "lineHeight": 17
    }
  },
  "params": [
    {
      "name": "selected_game",
      "value": 0
    }
  ],
  "encoding": {
    "x": {
      "field": "group",
      "type": "nominal",
      "sort": [
        "Global",
        "Malaysia",
        "Australia"
      ],
      "title": null,
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "labelExpr": "width < 220 ? (datum.label == 'Malaysia' ? 'MY' : datum.label == 'Australia' ? 'AU' : datum.label) : datum.label"
      }
    },
    "y": {
      "field": "name",
      "type": "nominal",
      "sort": {
        "field": "order"
      },
      "title": null,
      "axis": {
        "labelLimit": {
          "expr": "width < 220 ? 160 : 280"
        }
      }
    },
    "tooltip": [
      {
        "field": "name",
        "type": "nominal",
        "title": "Game"
      },
      {
        "field": "group",
        "type": "nominal",
        "title": "Ranking list"
      },
      {
        "field": "rank_label",
        "type": "nominal",
        "title": "Rank"
      },
      {
        "field": "local_ratings",
        "type": "quantitative",
        "title": "Local ratings",
        "format": ","
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "isValid(datum.rank) && datum.rank > 0",
            "field": "rank",
            "type": "quantitative",
            "scale": {
              "range": [
                "#252525",
                "#bdbdbd"
              ],
              "domain": [
                1,
                30
              ],
              "clamp": true
            },
            "legend": null
          },
          "value": "white"
        },
        "stroke": {
          "condition": [
            {
              "test": "datum.id == selected_game",
              "value": "#27313a"
            },
            {
              "test": "!isValid(datum.rank) || datum.rank <= 0",
              "value": "#bdbdbd"
            }
          ],
          "value": "white"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14
      },
      "encoding": {
        "text": {
          "condition": {
            "test": "isValid(datum.rank) && datum.rank > 0",
            "field": "rank_label",
            "type": "nominal"
          },
          "value": "–"
        },
        "color": {
          "condition": {
            "test": "isValid(datum.rank) && datum.rank <= 16",
            "value": "white"
          },
          "value": "black"
        }
      }
    }
  ]
}