{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Complexity of games in the historical top-20 lists",
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/top20_complexity.csv",
    "format": {
      "type": "csv",
      "parse": {
        "id": "number",
        "complexity": "number",
        "jitter": "number",
        "list_rank": "number",
        "complexity_votes": "number"
      }
    }
  },
  "config": {
    "font": "'Source Sans 3'",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#27313a",
      "titleColor": "#27313a",
      "gridColor": "#e9ecef",
      "domain": false,
      "tickColor": "#d8dde0",
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#27313a",
      "titleColor": "#27313a",
      "orient": "bottom",
      "padding": 12,
      "labelLimit": 240
    },
    "text": {
      "fontSize": 14,
      "lineBreak": "~",
      "lineHeight": 17
    }
  },
  "params": [
    {
      "name": "selected_game",
      "value": 0
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 60,
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "complexity",
          "type": "quantitative",
          "title": "Complexity (1 light, 5 heavy)",
          "scale": {
            "domain": [
              1,
              5
            ]
          },
          "axis": {
            "tickCount": 5
          }
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": [
            "Global",
            "Malaysia",
            "Australia"
          ],
          "title": null
        },
        "yOffset": {
          "field": "jitter",
          "type": "quantitative",
          "scale": {
            "domain": [
              -12,
              12
            ]
          }
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Global",
              "Malaysia",
              "Australia"
            ],
            "range": [
              "#3d4852",
              "#b65c0a",
              "#2674ae"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "test": "selected_game == 0 || datum.id == selected_game",
            "value": 1
          },
          "value": 0.2
        },
        "stroke": {
          "condition": {
            "test": "datum.id == selected_game",
            "value": "#27313a"
          },
          "value": "white"
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Game"
          },
          {
            "field": "group",
            "type": "nominal",
            "title": "2024 ranking list"
          },
          {
            "field": "list_rank",
            "type": "quantitative",
            "title": "Rank"
          },
          {
            "field": "complexity",
            "type": "quantitative",
            "title": "Recorded complexity",
            "format": ".2f"
          },
          {
            "field": "complexity_votes",
            "type": "quantitative",
            "title": "Complexity votes",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "complexity": 2.24
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          5,
          4
        ],
        "color": "#8c969f",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "complexity",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 250
        },
        "yOffset": {
          "value": 0
        },
        "tooltip": {
          "value": null
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "complexity": 2.24,
            "note": [
              "Typical new game",
              "(2020–25): 2.2"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 8,
        "fontWeight": "bold",
        "lineHeight": 17
      },
      "encoding": {
        "x": {
          "field": "complexity",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "yOffset": {
          "value": 0
        },
        "text": {
          "field": "note",
          "type": "nominal"
        },
        "color": {
          "value": "#27313a"
        },
        "tooltip": {
          "value": null
        }
      }
    }
  ]
}