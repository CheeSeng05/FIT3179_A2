{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mechanic shares by publication decade",
  "width": "container",
  "height": 400,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/mechanics_years.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "games": "number",
        "eligible_games": "number",
        "order": "number"
      }
    }
  },
  "config": {
    "font": "'Source Sans 3'",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#27313a",
      "titleColor": "#27313a",
      "gridColor": "#e9ecef",
      "domain": false,
      "tickColor": "#d8dde0",
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#27313a",
      "titleColor": "#27313a",
      "orient": "bottom",
      "padding": 12,
      "labelLimit": 240
    },
    "text": {
      "fontSize": 14,
      "lineBreak": "~",
      "lineHeight": 17
    }
  },
  "params": [
    {
      "name": "start_year",
      "value": 1950
    },
    {
      "name": "end_year",
      "value": 2025
    }
  ],
  "transform": [
    {
      "filter": "datum.year >= start_year && datum.year <= end_year"
    },
    {
      "filter": "datum.order < 8"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "games",
          "as": "games"
        },
        {
          "op": "sum",
          "field": "eligible_games",
          "as": "eligible_games"
        }
      ],
      "groupby": [
        "mechanic",
        "decade",
        "order"
      ]
    },
    {
      "calculate": "datum.eligible_games > 0 ? datum.games / datum.eligible_games : null",
      "as": "share"
    }
  ],
  "encoding": {
    "x": {
      "field": "decade",
      "type": "ordinal",
      "title": "Publication decade",
      "axis": {
        "labelAngle": 0,
        "labelExpr": "width < 300 ? [slice(datum.label, 0, 4), datum.label == '2020–2025' ? '–25' : 's'] : replace(datum.label, '2020–2025', '2020–25')"
      }
    },
    "y": {
      "field": "mechanic",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "order"
      },
      "axis": {
        "labelLimit": 100,
        "labelExpr": "datum.label == 'Roll / Spin and Move' ? ['Roll / Spin', 'and Move'] : split(datum.label, ' ')",
        "labelLineHeight": 14
      }
    },
    "color": {
      "field": "share",
      "type": "quantitative",
      "title": "Percentage of eligible games",
      "scale": {
        "range": [
          "#edf8fb",
          "#b2e2e2",
          "#66c2a4",
          "#2ca25f",
          "#006d2c"
        ],
        "domain": [
          0,
          0.6
        ],
        "interpolate": "lab",
        "clamp": true
      },
      "legend": {
        "title": "Mechanic percentage",
        "format": ".0%",
        "gradientLength": 160,
        "values": [
          0,
          0.3,
          0.6
        ],
        "labelExpr": "datum.value == 0.6 ? '60%+' : format(datum.value, '.0%')"
      }
    },
    "tooltip": [
      {
        "field": "mechanic",
        "type": "nominal",
        "title": "Mechanic"
      },
      {
        "field": "decade",
        "type": "ordinal",
        "title": "Publication decade"
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "Percentage",
        "format": ".1%"
      },
      {
        "field": "games",
        "type": "quantitative",
        "title": "Games",
        "format": ","
      },
      {
        "field": "eligible_games",
        "type": "quantitative",
        "title": "Games with mechanics",
        "format": ","
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      }
    },
    {
      "transform": [
        {
          "filter": "(datum.mechanic == 'Roll / Spin and Move' && (datum.decade == '1950s' || datum.decade == '2020–2025')) || (datum.mechanic == 'Cooperative Game' && datum.decade == '2020–2025')"
        }
      ],
      "mark": {
        "type": "text",
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".0%"
        },
        "color": {
          "condition": {
            "test": "datum.share > 0.3",
            "value": "white"
          },
          "value": "#27313a"
        }
      }
    }
  ]
}