{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mechanic shares by publication decade",
  "width": "container",
  "height": 350,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/mechanics_years.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "games": "number",
        "eligible_games": "number",
        "order": "number"
      }
    }
  },
  "config": {
    "font": "Arial",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#27313a",
      "titleColor": "#27313a",
      "gridColor": "#e9ecef",
      "domain": false,
      "tickColor": "#d8dde0",
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": "normal",
      "labelColor": "#27313a",
      "titleColor": "#27313a",
      "orient": "bottom",
      "padding": 12,
      "labelLimit": 240
    },
    "text": {
      "fontSize": 14
    }
  },
  "params": [
    {
      "name": "start_year",
      "value": 1950
    },
    {
      "name": "end_year",
      "value": 2025
    }
  ],
  "transform": [
    {
      "filter": "datum.year >= start_year && datum.year <= end_year"
    },
    {
      "filter": "datum.order < 8"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "games",
          "as": "games"
        },
        {
          "op": "sum",
          "field": "eligible_games",
          "as": "eligible_games"
        }
      ],
      "groupby": [
        "mechanic",
        "decade",
        "order"
      ]
    },
    {
      "calculate": "datum.eligible_games > 0 ? datum.games / datum.eligible_games : null",
      "as": "share"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "decade",
      "type": "ordinal",
      "title": "Publication decade",
      "axis": {
        "labelAngle": -35
      }
    },
    "y": {
      "field": "mechanic",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "order"
      },
      "axis": {
        "labelLimit": 155
      }
    },
    "color": {
      "field": "share",
      "type": "quantitative",
      "title": "Percentage of eligible games",
      "scale": {
        "range": [
          "#edf8fb",
          "#b2e2e2",
          "#66c2a4",
          "#2ca25f",
          "#006d2c"
        ],
        "domain": [
          0,
          1
        ],
        "interpolate": "lab"
      },
      "legend": {
        "title": "Mechanic percentage",
        "format": ".0%",
        "gradientLength": 160,
        "values": [
          0,
          0.5,
          1
        ]
      }
    },
    "tooltip": [
      {
        "field": "mechanic",
        "type": "nominal",
        "title": "Mechanic"
      },
      {
        "field": "decade",
        "type": "ordinal",
        "title": "Publication decade"
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "Percentage",
        "format": ".1%"
      },
      {
        "field": "games",
        "type": "quantitative",
        "title": "Games",
        "format": ","
      },
      {
        "field": "eligible_games",
        "type": "quantitative",
        "title": "Games with mechanics",
        "format": ","
      }
    ]
  }
}