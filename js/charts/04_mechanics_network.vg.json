{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Mechanics used together; strongest twelve links among eight common mechanics",
  "width": 700,
  "height": 340,
  "padding": 5,
  "autosize": "none",
  "background": "transparent",
  "signals": [
    {
      "name": "radius_x",
      "update": "width * (width < 500 ? 0.25 : 0.34)"
    },
    {
      "name": "radius_y",
      "update": "height * 0.28"
    }
  ],
  "data": [
    {
      "name": "nodes",
      "url": "data/network_nodes.csv",
      "format": {
        "type": "csv",
        "parse": {
          "id": "number",
          "games": "number",
          "angle": "number"
        }
      },
      "transform": [
        {
          "type": "formula",
          "expr": "width/2 + radius_x*cos(datum.angle)",
          "as": "x"
        },
        {
          "type": "formula",
          "expr": "height/2 + radius_y*sin(datum.angle)",
          "as": "y"
        }
      ]
    },
    {
      "name": "links",
      "url": "data/network_links.csv",
      "format": {
        "type": "csv",
        "parse": {
          "source": "number",
          "target": "number",
          "shared_games": "number"
        }
      },
      "transform": [
        {
          "type": "lookup",
          "from": "nodes",
          "key": "id",
          "fields": [
            "source"
          ],
          "values": [
            "x",
            "y"
          ],
          "as": [
            "x1",
            "y1"
          ]
        },
        {
          "type": "lookup",
          "from": "nodes",
          "key": "id",
          "fields": [
            "target"
          ],
          "values": [
            "x",
            "y"
          ],
          "as": [
            "x2",
            "y2"
          ]
        }
      ]
    },
    {
      "name": "key_link",
      "source": "links",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.source_name == 'Simulation' && datum.target_name == 'Dice Rolling'"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "link_width",
      "type": "linear",
      "domain": {
        "data": "links",
        "field": "shared_games"
      },
      "range": [
        1,
        7
      ],
      "zero": true
    },
    {
      "name": "node_size",
      "type": "sqrt",
      "domain": {
        "data": "nodes",
        "field": "games"
      },
      "range": [
        80,
        600
      ],
      "zero": true
    }
  ],
  "marks": [
    {
      "type": "rule",
      "from": {
        "data": "links"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x1"
          },
          "y": {
            "field": "y1"
          },
          "x2": {
            "field": "x2"
          },
          "y2": {
            "field": "y2"
          },
          "stroke": {
            "signal": "datum.source_name == 'Simulation' && datum.target_name == 'Dice Rolling' ? '#27313a' : '#167d73'"
          },
          "strokeOpacity": {
            "signal": "datum.source_name == 'Simulation' && datum.target_name == 'Dice Rolling' ? 1 : 0.4"
          },
          "strokeWidth": {
            "scale": "link_width",
            "field": "shared_games"
          },
          "tooltip": {
            "signal": "{'Mechanic 1': datum.source_name, 'Mechanic 2': datum.target_name, 'Shared games': datum.shared_games}"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "scale": "node_size",
            "field": "games"
          },
          "fill": {
            "value": "#167d73"
          },
          "stroke": {
            "value": "white"
          },
          "tooltip": {
            "signal": "{'Mechanic':datum.mechanic, 'Games':datum.games}"
          }
        },
        "hover": {
          "fill": {
            "value": "#222b34"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "width/2 + (radius_x+22)*cos(datum.angle)"
          },
          "y": {
            "signal": "height/2 + (radius_y+22)*sin(datum.angle) - (sin(datum.angle) < -0.9 ? 12 : 0)"
          },
          "text": {
            "signal": "split(datum.label, '\\n')"
          },
          "align": {
            "signal": "cos(datum.angle) > 0.4 ? 'left' : cos(datum.angle) < -0.4 ? 'right' : 'center'"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Source Sans 3'"
          },
          "fontSize": {
            "value": 14
          },
          "fill": {
            "value": "#27313a"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "key_link"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x1+datum.x2)/2 + (width < 500 ? 50 : 35)"
          },
          "y": {
            "signal": "(datum.y1+datum.y2)/2 - 20"
          },
          "text": {
            "signal": "width < 500 ? [format(datum.shared_games, ','), 'shared games'] : [format(datum.shared_games, ',') + ' shared games']"
          },
          "align": {
            "value": "center"
          },
          "font": {
            "value": "'Source Sans 3'"
          },
          "fontSize": {
            "value": 14
          },
          "fontWeight": {
            "value": "bold"
          },
          "lineHeight": {
            "value": 16
          },
          "fill": {
            "value": "#27313a"
          }
        }
      }
    }
  ]
}