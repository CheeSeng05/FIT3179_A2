{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Rating contributors in the historical country analysis",
  "width": "container",
  "height": 400,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/communities.csv",
    "format": {
      "type": "csv",
      "parse": {
        "num_users": "number",
        "total_ratings": "number",
        "longitude": "number",
        "latitude": "number"
      }
    }
  },
  "config": {
    "font": "Arial",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#444c54",
      "titleColor": "#444c54",
      "gridColor": "#e9ecef",
      "domain": false,
      "tickColor": "#d8dde0",
      "titlePadding": 12,
      "labelPadding": 7
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "orient": "bottom",
      "padding": 12,
      "labelLimit": 190
    },
    "text": {
      "fontSize": 12
    }
  },
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "data/world.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6e9ec",
        "stroke": "white",
        "strokeWidth": 0.6
      }
    },
    {
      "transform": [
        {
          "filter": "datum.highlight == 'Other countries'"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#8c969f",
        "opacity": 0.5,
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "num_users",
          "type": "quantitative",
          "title": "Rating contributors",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              131718
            ],
            "range": [
              0,
              3800
            ]
          },
          "legend": {
            "values": [
              1000,
              10000,
              100000
            ],
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "country_name",
            "type": "nominal",
            "title": "Self-reported country"
          },
          {
            "field": "num_users",
            "type": "quantitative",
            "title": "Contributors",
            "format": ","
          },
          {
            "field": "total_ratings",
            "type": "quantitative",
            "title": "Ratings",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.highlight != 'Other countries'"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "num_users",
          "type": "quantitative",
          "title": "Rating contributors",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              131718
            ],
            "range": [
              0,
              3800
            ]
          },
          "legend": {
            "values": [
              1000,
              10000,
              100000
            ],
            "format": ",.0f"
          }
        },
        "color": {
          "field": "highlight",
          "type": "nominal",
          "scale": {
            "domain": [
              "Malaysia",
              "Australia"
            ],
            "range": [
              "#b65c0a",
              "#2674ae"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "country_name",
            "type": "nominal",
            "title": "Self-reported country"
          },
          {
            "field": "num_users",
            "type": "quantitative",
            "title": "Contributors",
            "format": ","
          },
          {
            "field": "total_ratings",
            "type": "quantitative",
            "title": "Ratings",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.highlight != 'Other countries'"
        },
        {
          "calculate": "datum.country_name + ': ' + format(datum.num_users, ',')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": {
          "expr": "datum.highlight == 'Australia' ? -12 : -8"
        },
        "dy": {
          "expr": "datum.highlight == 'Australia' ? 24 : -15"
        },
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#27313a"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ]
}