{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Total Tourist Spending By State",
    "fontSize": 16,
    "anchor": "start"
  },
  "width": "container",
  "height": 400,
  "projection": {
    "type": "equirectangular"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
        "format": { "type": "json", "property": "features" }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": { "url": "data/map2.csv" },
            "key": "State",
            "fields": ["Spend (AUD m)", "State code"]
          }
        }
      ],
      "mark": { "type": "geoshape", "stroke": "white", "strokeWidth": 1 },
      "encoding": {
        "color": {
          "field": "Spend (AUD m)",
          "type": "quantitative",
          "title": "Expenses ($M)",
          "scale": { "scheme": "blues" }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "Spend (AUD m)",
            "type": "quantitative",
            "title": "Expenses ($M)",
            "format": ",.1f"
          }
        ]
      }
    }
  ]
}

