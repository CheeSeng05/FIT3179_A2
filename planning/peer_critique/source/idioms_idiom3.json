{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "What Tourists Spend their Money On",
    "fontSize": 16,
    "anchor": "start"
  },
  "width": "container",
  "height": 380,
  "data": { "url": "data/chart2.csv" },
  "transform": [
    {
      "aggregate": [
        { "op": "sum", "field": "Spend (AUD m)", "as": "Total_Category_Spend" }
      ],
      "groupby": ["Category"]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 20,
        "outerRadius": 140,
        "stroke": "#fff"
      },
      "encoding": {
        "theta": {
          "field": "Total_Category_Spend",
          "type": "quantitative",
          "stack": true
        },
        "radius": {
          "field": "Total_Category_Spend",
          "type": "quantitative",
          "scale": { "type": "sqrt", "zero": true, "rangeMin": 20 }
        },
        "color": {
          "field": "Category",
          "type": "nominal",
          "scale": { "scheme": "tableau10" }
        },
        "tooltip": [
          { "field": "Category", "type": "nominal" },
          {
            "field": "Total_Category_Spend",
            "type": "quantitative",
            "title": "Total Spend ($M)",
            "format": ",.1f"
          }
        ]
      }
    }
  ]
}

